\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The emergence gap trends down in upsets and up in controls. (a) Per-match least-squares slope of $g(t)=\Psi _{\text  {und}}(t)-\Psi _{\text  {fav}}(t)$ for the primary specification (\texttt  {\small  V\_all}, $\ell =1$), horizontal bars are group means. (b) Hedges' $g$ for the upset--control slope difference in each of the 18 feature $\times $ order cells, starred cells survive FDR correction. $V_{\mathrm  {clust,vel}}$ is the only feature with the opposite sign, and is not significant in any cell.\relax }}{14}{figure.caption.15}\protected@file@percent }
\newlabel{fig:gap}{{3}{14}{The emergence gap trends down in upsets and up in controls. (a) Per-match least-squares slope of $g(t)=\Psi _{\text {und}}(t)-\Psi _{\text {fav}}(t)$ for the primary specification (\code {V\_all}, $\ell =1$), horizontal bars are group means. (b) Hedges' $g$ for the upset--control slope difference in each of the 18 feature $\times $ order cells, starred cells survive FDR correction. $\Vcv $ is the only feature with the opposite sign, and is not significant in any cell.\relax }{figure.caption.15}{}}
\newlabel{fig:gap@cref}{{[figure][3][]3}{[1][14][]14}}
\citation{rosas2020}
